<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <LangVersion>10</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PackageId>Envy.Config</PackageId>
    <Version>0.2.0</Version>
    <Title>Envy.Config</Title>
    <Authors>MaNiSh-9211</Authors>
    <Description>Typed configuration loading for envy.yaml — validates, layers and mocks natively in .NET (ASP.NET Core, Worker Services, console apps)</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/MaNiSh-9211/envy</RepositoryUrl>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="16.1.3" />
  </ItemGroup>

</Project>
